<style>
    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: #f8fafc;
        min-height: 100vh;
        margin: 0;
        padding: 20px;
    }
    
    .payment-container {
        max-width: 800px;
        margin: 0 auto;
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        border: 1px solid #e2e8f0;
    }
    
    .payment-header {
        background: #3b82f6;
        padding: 2rem;
        text-align: center;
        color: white;
    }
    
    .payment-header h1 {
        font-size: 2rem;
        font-weight: 600;
        margin: 0 0 0.5rem 0;
    }
    
    .merchant-info {
        font-size: 1rem;
        margin: 0;
        opacity: 0.9;
    }
    
    .payment-content {
        padding: 0;
    }
    
    .product-showcase {
        background-color: #f8fafc;
        padding: 2rem;
        border-bottom: 1px solid #e2e8f0;
    }
    
    .product-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        align-items: center;
    }
    
    @media (max-width: 768px) {
        .product-layout {
            grid-template-columns: 1fr;
            text-align: center;
        }
    }
    
    .product-image-container {
        position: relative;
    }
    
    .product-image {
        width: 100%;
        max-height: 300px;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        border: 1px solid #e2e8f0;
    }
    
    .product-details h2 {
        font-size: 1.75rem;
        font-weight: 600;
        color: #1e293b;
        margin: 0 0 1rem 0;
        line-height: 1.3;
    }
    
    .product-description {
        color: #64748b;
        font-size: 1rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }
    
    .price-tag {
        display: inline-flex;
        align-items: center;
        background: #3b82f6;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-size: 1.25rem;
        font-weight: 600;
        box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
    }
    
    .payment-details {
        background: white;
        padding: 2rem;
    }
    
    .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #1e293b;
        margin: 0 0 1.5rem 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .payment-description {
        background: #f1f5f9;
        border-left: 4px solid #3b82f6;
        padding: 1.5rem;
        margin-bottom: 2rem;
        border-radius: 0 8px 8px 0;
    }
    
    .payment-description h3 {
        color: #1e293b;
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0 0 0.5rem 0;
    }
    
    .payment-description p {
        color: #64748b;
        margin: 0;
        line-height: 1.6;
    }
    
    .form-section {
        background: white;
        padding: 2rem;
        border-top: 1px solid #e2e8f0;
    }
    
    .form-group {
        margin-bottom: 1.5rem;
    }
    
    .form-label {
        display: block;
        font-weight: 500;
        color: #374151;
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }
    
    .form-input {
        width: 100%;
        padding: 0.875rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.2s ease;
        background: white;
    }
    
    .form-input:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    
    .payment-methods {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }
    
    .payment-method {
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.25rem;
        cursor: pointer;
        transition: all 0.2s ease;
        background: white;
        position: relative;
    }
    
    .payment-method:hover {
        border-color: #3b82f6;
        box-shadow: 0 2px 8px rgba(59, 130, 246, 0.1);
    }
    
    .payment-method input[type="radio"] {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }
    
    .payment-method input[type="radio"]:checked + .method-content {
        color: #3b82f6;
    }
    
    .payment-method input[type="radio"]:checked + .method-content::after {
        content: '✓';
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        background: #3b82f6;
        color: white;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: bold;
    }
    
    .method-content {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        position: relative;
    }
    
    .method-icon {
        font-size: 1.5rem;
        color: #3b82f6;
    }
    
    .submit-button {
        width: 100%;
        background: #3b82f6;
        color: white;
        font-weight: 600;
        padding: 1rem 2rem;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        font-size: 1.1rem;
        transition: all 0.2s ease;
    }
    
    .submit-button:hover {
        background: #2563eb;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }
    
    .submit-button:active {
        transform: translateY(0);
    }
    
    .submit-button:disabled {
        background: #94a3b8;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }
    
    .secure-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        color: #64748b;
        font-size: 0.9rem;
        margin-top: 1rem;
    }
    
    .no-product-layout {
        text-align: center;
        padding: 3rem 2rem;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }
    
    .no-product-layout .price-tag {
        font-size: 1.5rem;
        padding: 1rem 2rem;
    }
    
    /* Required field styling */
    .required {
        color: #ef4444;
    }
    
    /* Info text styling */
    .info-text {
        color: #64748b;
        font-size: 0.85rem;
    }
    
    /* Success/Error border colors for validation */
    .form-input.valid {
        border-color: #10b981;
    }
    
    .form-input.invalid {
        border-color: #ef4444;
    }
</style>

<div class="payment-container">
    <div class="payment-card">
        <div class="payment-header">
            <h2 class="payment-title">{{paymentlink.title}}</h2>
            <p class="merchant-name">{{merchant.merchant_name}}</p>
        </div>
        
        <div class="product-info">
            <h2 class="product-price">{{amount_formatted}}</h2>
            
            {{#paymentlink.description}}
            <h3 class="section-title">
                📝 Ödeme Açıklaması
            </h3>
            <p class="product-description">{{paymentlink.description}}</p>
            {{/paymentlink.description}}
        </div>
        
        <div class="form-section">
            <form action="{{wwwroot}}/local/lidio/pay.php?code={{paymentlink.link_code}}" method="post" id="payment-form">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                
                <h3 class="section-title">
                    👤 Müşteri Bilgileri
                </h3>
                
                <div class="form-group">
                    <label for="customer_name" class="form-label">Ad Soyad</label>
                    <input type="text" id="customer_name" name="customer_name" required class="form-input" placeholder="Adınızı ve soyadınızı girin">
                </div>
                
                {{#contact_requirements.email_required}}
                <div class="form-group">
                    <label for="customer_email" class="form-label">E-posta Adresi <span class="required">*</span></label>
                    <input type="text" id="customer_email" name="customer_email" required class="form-input" placeholder="ornek@email.com">
                </div>
                {{/contact_requirements.email_required}}
                
                {{#contact_requirements.phone_required}}
                <div class="form-group">
                    <label for="customer_phone" class="form-label">Telefon Numarası <span class="required">*</span></label>
                    <input type="tel" id="customer_phone" name="customer_phone" required class="form-input" placeholder="+90 5XX XXX XX XX">
                </div>
                {{/contact_requirements.phone_required}}
                
                {{#contact_requirements.phone_or_email}}
                <div class="form-group">
                    <label for="customer_email" class="form-label">E-posta Adresi <span class="info-text">(E-posta veya telefon gerekli)</span></label>
                    <input type="text" id="customer_email" name="customer_email" class="form-input contact-field" placeholder="ornek@email.com">
                </div>
                
                <div class="form-group">
                    <label for="customer_phone" class="form-label">Telefon Numarası <span class="info-text">(E-posta veya telefon gerekli)</span></label>
                    <input type="tel" id="customer_phone" name="customer_phone" class="form-input contact-field" placeholder="+90 5XX XXX XX XX">
                </div>
                {{/contact_requirements.phone_or_email}}
                
                {{#contact_requirements.both_required}}
                <div class="form-group">
                    <label for="customer_email" class="form-label">E-posta Adresi <span class="required">*</span></label>
                    <input type="text" id="customer_email" name="customer_email" required class="form-input" placeholder="ornek@email.com">
                </div>
                
                <div class="form-group">
                    <label for="customer_phone" class="form-label">Telefon Numarası <span class="required">*</span></label>
                    <input type="tel" id="customer_phone" name="customer_phone" required class="form-input" placeholder="+90 5XX XXX XX XX">
                </div>
                {{/contact_requirements.both_required}}
                
                <h3 class="section-title">
                    💳 Ödeme Bilgileri
                </h3>
                
                <div class="form-group">
                    <label for="card_holder" class="form-label">Kart Üzerindeki İsim</label>
                    <input type="text" id="card_holder" name="card_holder" class="form-input" required placeholder="Kart üzerindeki ismi girin">
                </div>
                
                <div class="form-group">
                    <label for="card_number" class="form-label">Kart Numarası</label>
                    <input type="text" id="card_number" name="card_number" class="form-input" required placeholder="1234 5678 9012 3456" maxlength="19">
                </div>
                
                <div class="form-row">
                    <div class="form-group half">
                        <label class="form-label">Son Kullanma Tarihi</label>
                        <div class="expiry-inputs">
                            <select name="exp_month" class="form-select" required>
                                <option value="" disabled selected>Ay</option>
                                {{#exp_months}}
                                <option value="{{.}}">{{.}}</option>
                                {{/exp_months}}
                            </select>
                            <select name="exp_year" class="form-select" required>
                                <option value="" disabled selected>Yıl</option>
                                {{#exp_years}}
                                <option value="{{.}}">{{.}}</option>
                                {{/exp_years}}
                            </select>
                        </div>
                    </div>
                    
                    <div class="form-group half">
                        <label for="cvv" class="form-label">Güvenlik Kodu (CVV)</label>
                        <input type="text" id="cvv" name="cvv" class="form-input" required placeholder="123" maxlength="4">
                    </div>
                </div>
                
                <button type="submit" class="submit-button">
                    🔒 Güvenli Ödeme Yap - {{amount_formatted}}
                </button>
                
                <div class="secure-badge">
                    🔐 256-bit SSL ile güvenli ödeme
                </div>
                
                <div class="card-icons">
                    <img src="https://cdn-icons-png.flaticon.com/512/349/349221.png" alt="Visa" width="40">
                    <img src="https://cdn-icons-png.flaticon.com/512/349/349228.png" alt="MasterCard" width="40">
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Credit card number formatting
    const cardNumberInput = document.getElementById('card_number');
    if (cardNumberInput) {
        cardNumberInput.addEventListener('input', function(e) {
            // Remove all non-digits
            let value = this.value.replace(/\D/g, '');
            
            // Add a space after every 4 digits
            let formattedValue = '';
            for (let i = 0; i < value.length; i++) {
                if (i > 0 && i % 4 === 0) {
                    formattedValue += ' ';
                }
                formattedValue += value[i];
            }
            
            // Update the input value
            this.value = formattedValue;
        });
    }
    
    // CVV validation - only digits
    const cvvInput = document.getElementById('cvv');
    if (cvvInput) {
        cvvInput.addEventListener('input', function(e) {
            this.value = this.value.replace(/\D/g, '');
        });
    }
    
    // Real-time validation feedback
    {{#contact_requirements.phone_or_email}}
    const emailField = document.getElementById('customer_email');
    const phoneField = document.getElementById('customer_phone');

    function updateValidationState() {
        const hasEmail = emailField.value.trim().length > 0;
        const hasPhone = phoneField.value.trim().length > 0;
        
        if (hasEmail || hasPhone) {
            emailField.style.borderColor = hasEmail ? '#48bb78' : '#e2e8f0';
            phoneField.style.borderColor = hasPhone ? '#48bb78' : '#e2e8f0';
        } else {
            emailField.style.borderColor = '#e53e3e';
            phoneField.style.borderColor = '#e53e3e';
        }
    }

    emailField.addEventListener('input', updateValidationState);
    phoneField.addEventListener('input', updateValidationState);
    {{/contact_requirements.phone_or_email}}

    // Form submission animation
    const paymentForm = document.getElementById('payment-form');
    if (paymentForm) {
        paymentForm.addEventListener('submit', function(e) {
            const submitButton = this.querySelector('.submit-button');
            const originalText = submitButton.innerHTML;
            submitButton.innerHTML = '⏳ İşleminiz gerçekleştiriliyor...';
            submitButton.disabled = true;
            
            // Re-enable button after 30 seconds (timeout)
            setTimeout(() => {
                submitButton.innerHTML = originalText;
                submitButton.disabled = false;
            }, 30000);
        });
    }
});
</script> 