<style>
    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: #f8fafc;
        min-height: 100vh;
        margin: 0;
        padding: 20px;
    }
    
    .payment-container {
        max-width: 800px;
        margin: 0 auto;
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        border: 1px solid #e2e8f0;
    }
    
    .payment-header {
        background: #3b82f6;
        padding: 2rem;
        text-align: center;
        color: white;
    }
    
    .payment-header h1 {
        font-size: 2rem;
        font-weight: 600;
        margin: 0 0 0.5rem 0;
    }
    
    .merchant-info {
        font-size: 1rem;
        margin: 0;
        opacity: 0.9;
    }
    
    .payment-content {
        padding: 0;
    }
    
    .product-showcase {
        background-color: #f8fafc;
        padding: 2rem;
        border-bottom: 1px solid #e2e8f0;
    }
    
    .product-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        align-items: center;
    }
    
    @media (max-width: 768px) {
        .product-layout {
            grid-template-columns: 1fr;
            text-align: center;
        }
    }
    
    .product-image-container {
        position: relative;
    }
    
    .product-image {
        width: 100%;
        max-height: 300px;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        border: 1px solid #e2e8f0;
    }
    
    .product-details h2 {
        font-size: 1.75rem;
        font-weight: 600;
        color: #1e293b;
        margin: 0 0 1rem 0;
        line-height: 1.3;
    }
    
    .product-description {
        color: #64748b;
        font-size: 1rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }
    
    .price-tag {
        display: inline-flex;
        align-items: center;
        background: #3b82f6;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-size: 1.25rem;
        font-weight: 600;
        box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
    }
    
    .payment-details {
        background: white;
        padding: 2rem;
    }
    
    .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #1e293b;
        margin: 0 0 1.5rem 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .payment-description {
        background: #f1f5f9;
        border-left: 4px solid #3b82f6;
        padding: 1.5rem;
        margin-bottom: 2rem;
        border-radius: 0 8px 8px 0;
    }
    
    .payment-description h3 {
        color: #1e293b;
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0 0 0.5rem 0;
    }
    
    .payment-description p {
        color: #64748b;
        margin: 0;
        line-height: 1.6;
    }
    
    .form-section {
        background: white;
        padding: 2rem;
        border-top: 1px solid #e2e8f0;
    }
    
    .form-group {
        margin-bottom: 1.5rem;
    }
    
    .form-label {
        display: block;
        font-weight: 500;
        color: #374151;
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }
    
    .form-input {
        width: 100%;
        padding: 0.875rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.2s ease;
        background: white;
    }
    
    .form-input:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    
    .payment-methods {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }
    
    .payment-method {
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.25rem;
        cursor: pointer;
        transition: all 0.2s ease;
        background: white;
        position: relative;
    }
    
    .payment-method:hover {
        border-color: #3b82f6;
        box-shadow: 0 2px 8px rgba(59, 130, 246, 0.1);
    }
    
    .payment-method input[type="radio"] {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }
    
    .payment-method input[type="radio"]:checked + .method-content {
        color: #3b82f6;
    }
    
    .payment-method input[type="radio"]:checked + .method-content::after {
        content: '✓';
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        background: #3b82f6;
        color: white;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: bold;
    }
    
    .method-content {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        position: relative;
    }
    
    .method-icon {
        font-size: 1.5rem;
        color: #3b82f6;
    }
    
    .submit-button {
        width: 100%;
        background: #3b82f6;
        color: white;
        font-weight: 600;
        padding: 1rem 2rem;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        font-size: 1.1rem;
        transition: all 0.2s ease;
    }
    
    .submit-button:hover {
        background: #2563eb;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }
    
    .submit-button:active {
        transform: translateY(0);
    }
    
    .submit-button:disabled {
        background: #94a3b8;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }
    
    .secure-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        color: #64748b;
        font-size: 0.9rem;
        margin-top: 1rem;
    }
    
    .no-product-layout {
        text-align: center;
        padding: 3rem 2rem;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }
    
    .no-product-layout .price-tag {
        font-size: 1.5rem;
        padding: 1rem 2rem;
    }
    
    /* Required field styling */
    .required {
        color: #ef4444;
    }
    
    /* Info text styling */
    .info-text {
        color: #64748b;
        font-size: 0.85rem;
    }
    
    /* Success/Error border colors for validation */
    .form-input.valid {
        border-color: #10b981;
    }
    
    .form-input.invalid {
        border-color: #ef4444;
    }
</style>

<div class="payment-container">
    <!-- Header -->
    <div class="payment-header">
        <h1>{{paymentlink.title}}</h1>
        <p class="merchant-info">{{merchant.company_name}}</p>
    </div>
    
    <div class="payment-content">
        {{#paymentlink.product_name}}
        <!-- Product Showcase -->
        <div class="product-showcase">
            <div class="product-layout">
                <div class="product-image-container">
                    {{#paymentlink.product_image}}
                    <img src="{{paymentlink.product_image}}" alt="{{paymentlink.product_name}}" class="product-image">
                    {{/paymentlink.product_image}}
                    {{^paymentlink.product_image}}
                    <div style="background: #f1f5f9; height: 300px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 3rem; border: 2px dashed #cbd5e1;">
                        📦
                    </div>
                    {{/paymentlink.product_image}}
                </div>
                
                <div class="product-details">
                    <h2>{{paymentlink.product_name}}</h2>
                    {{#paymentlink.product_description}}
                    <p class="product-description">{{paymentlink.product_description}}</p>
                    {{/paymentlink.product_description}}
                    <div class="price-tag">
                        {{amount_formatted}}
                    </div>
                </div>
            </div>
        </div>
        {{/paymentlink.product_name}}
        
        {{^paymentlink.product_name}}
        <!-- No Product Layout -->
        <div class="no-product-layout">
            <div class="price-tag">
                {{amount_formatted}}
            </div>
        </div>
        {{/paymentlink.product_name}}
        
        <!-- Payment Description -->
        {{#paymentlink.description}}
        <div class="payment-details">
            <div class="payment-description">
                <h3>📝 Ödeme Açıklaması</h3>
                <p>{{paymentlink.description}}</p>
            </div>
        </div>
        {{/paymentlink.description}}
        
        <!-- Payment Form -->
        <div class="form-section">
            <h3 class="section-title">
                👤 Müşteri Bilgileri
            </h3>
            
            <form action="{{wwwroot}}/local/lidio/pay.php?code={{paymentlink.link_code}}" method="post" id="payment-form">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                
                <div class="form-group">
                    <label for="customer_name" class="form-label">Ad Soyad</label>
                    <input type="text" id="customer_name" name="customer_name" required class="form-input" placeholder="Adınızı ve soyadınızı girin">
                </div>
                
                {{#contact_requirements.email_required}}
                <div class="form-group">
                    <label for="customer_email" class="form-label">E-posta Adresi <span class="required">*</span></label>
                    <input type="text" id="customer_email" name="customer_email" required class="form-input" placeholder="ornek@email.com">
                </div>
                {{/contact_requirements.email_required}}
                
                {{#contact_requirements.phone_required}}
                <div class="form-group">
                    <label for="customer_phone" class="form-label">Telefon Numarası <span class="required">*</span></label>
                    <input type="tel" id="customer_phone" name="customer_phone" required class="form-input" placeholder="+90 5XX XXX XX XX">
                </div>
                {{/contact_requirements.phone_required}}
                
                {{#contact_requirements.phone_or_email}}
                <div class="form-group">
                    <label for="customer_email" class="form-label">E-posta Adresi <span class="info-text">(E-posta veya telefon gerekli)</span></label>
                    <input type="text" id="customer_email" name="customer_email" class="form-input contact-field" placeholder="ornek@email.com">
                </div>
                
                <div class="form-group">
                    <label for="customer_phone" class="form-label">Telefon Numarası <span class="info-text">(E-posta veya telefon gerekli)</span></label>
                    <input type="tel" id="customer_phone" name="customer_phone" class="form-input contact-field" placeholder="+90 5XX XXX XX XX">
                </div>
                {{/contact_requirements.phone_or_email}}
                
                {{#contact_requirements.both_required}}
                <div class="form-group">
                    <label for="customer_email" class="form-label">E-posta Adresi <span class="required">*</span></label>
                    <input type="text" id="customer_email" name="customer_email" required class="form-input" placeholder="ornek@email.com">
                </div>
                
                <div class="form-group">
                    <label for="customer_phone" class="form-label">Telefon Numarası <span class="required">*</span></label>
                    <input type="tel" id="customer_phone" name="customer_phone" required class="form-input" placeholder="+90 5XX XXX XX XX">
                </div>
                {{/contact_requirements.both_required}}
                
                <h3 class="section-title" style="margin-top: 2rem;">
                    💳 Ödeme Yöntemi
                </h3>
                
                <div class="payment-methods">
                    <div class="payment-method">
                        <input type="radio" id="credit_card" name="payment_method" value="credit_card" required>
                        <label for="credit_card" class="method-content">
                            <div class="method-icon">💳</div>
                            <div>
                                <div style="font-weight: 600;">Kredi Kartı</div>
                                <div class="info-text">Visa, Mastercard</div>
                            </div>
                        </label>
                    </div>
                    
                    <div class="payment-method">
                        <input type="radio" id="bank_transfer" name="payment_method" value="bank_transfer">
                        <label for="bank_transfer" class="method-content">
                            <div class="method-icon">🏦</div>
                            <div>
                                <div style="font-weight: 600;">Banka Havalesi</div>
                                <div class="info-text">EFT / Havale</div>
                            </div>
                        </label>
                    </div>
                </div>
                
                <button type="submit" class="submit-button">
                    🔒 Güvenli Ödeme Yap - {{amount_formatted}}
                </button>
                
                <div class="secure-badge">
                    🔐 256-bit SSL ile güvenli ödeme
                </div>
            </form>
        </div>
    </div>
</div>

<script>
// Modern notification system
function showNotification(message, type = 'error') {
    const notification = document.createElement('div');
    notification.style.cssText = `
        position: fixed;
        top: 20px;
        right: 20px;
        padding: 1rem 1.5rem;
        border-radius: 12px;
        color: white;
        font-weight: 600;
        z-index: 10000;
        transform: translateX(100%);
        transition: transform 0.3s ease;
        max-width: 400px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    `;
    
    if (type === 'error') {
        notification.style.background = 'linear-gradient(135deg, #e53e3e 0%, #c53030 100%)';
        notification.innerHTML = `🚫 ${message}`;
    } else if (type === 'success') {
        notification.style.background = 'linear-gradient(135deg, #48bb78 0%, #38a169 100%)';
        notification.innerHTML = `✅ ${message}`;
    }
    
    document.body.appendChild(notification);
    
    setTimeout(() => {
        notification.style.transform = 'translateX(0)';
    }, 100);
    
    setTimeout(() => {
        notification.style.transform = 'translateX(100%)';
        setTimeout(() => document.body.removeChild(notification), 300);
    }, 4000);
}

// Form validation
document.getElementById('payment-form').addEventListener('submit', function(e) {
    const customerName = document.getElementById('customer_name').value.trim();
    
    // Check name field
    if (!customerName || customerName.length < 3) {
        e.preventDefault();
        showNotification('Lütfen geçerli bir ad soyad girin (en az 3 karakter)');
        return false;
    }
    
    {{#contact_requirements.phone_or_email}}
    const email = document.getElementById('customer_email').value.trim();
    const phone = document.getElementById('customer_phone').value.trim();
    
    if (!email && !phone) {
        e.preventDefault();
        showNotification('Lütfen e-posta adresi veya telefon numarası girin');
        return false;
    }
    
    // Validate phone format if provided (Turkish phone number)
    if (phone && !/^[\+]?[0-9\s\-\(\)]{10,}$/.test(phone)) {
        e.preventDefault();
        showNotification('Lütfen geçerli bir telefon numarası girin');
        return false;
    }
    {{/contact_requirements.phone_or_email}}
    
    // Check payment method selection
    const paymentMethod = document.querySelector('input[name="payment_method"]:checked');
    if (!paymentMethod) {
        e.preventDefault();
        showNotification('Lütfen bir ödeme yöntemi seçin');
        return false;
    }
    
    // Show loading state
    const submitButton = this.querySelector('.submit-button');
    const originalText = submitButton.innerHTML;
    submitButton.innerHTML = '⏳ İşleminiz gerçekleştiriliyor...';
    submitButton.disabled = true;
    
    // Re-enable button after 30 seconds (timeout)
    setTimeout(() => {
        submitButton.innerHTML = originalText;
        submitButton.disabled = false;
    }, 30000);
});

// Real-time validation feedback
{{#contact_requirements.phone_or_email}}
const emailField = document.getElementById('customer_email');
const phoneField = document.getElementById('customer_phone');

function updateValidationState() {
    const hasEmail = emailField.value.trim().length > 0;
    const hasPhone = phoneField.value.trim().length > 0;
    
    if (hasEmail || hasPhone) {
        emailField.style.borderColor = hasEmail ? '#48bb78' : '#e2e8f0';
        phoneField.style.borderColor = hasPhone ? '#48bb78' : '#e2e8f0';
    } else {
        emailField.style.borderColor = '#e53e3e';
        phoneField.style.borderColor = '#e53e3e';
    }
}

emailField.addEventListener('input', updateValidationState);
phoneField.addEventListener('input', updateValidationState);
{{/contact_requirements.phone_or_email}}

// Payment method selection animation
document.querySelectorAll('.payment-method').forEach(method => {
    method.addEventListener('click', function() {
        const radio = this.querySelector('input[type="radio"]');
        radio.checked = true;
        
        // Remove selection from other methods
        document.querySelectorAll('.payment-method').forEach(other => {
            if (other !== this) {
                other.style.borderColor = '#e2e8f0';
                other.style.background = '#f8fafc';
            }
        });
        
        // Highlight selected method
        this.style.borderColor = '#3b82f6';
        this.style.background = 'white';
    });
});

// Auto-format phone number
{{#contact_requirements.phone_or_email}}
phoneField.addEventListener('input', function() {
    let value = this.value.replace(/\D/g, ''); // Remove non-digits
    
    // Turkish phone number formatting
    if (value.startsWith('90')) {
        value = '+' + value;
    } else if (value.startsWith('0')) {
        value = '+90' + value.substring(1);
    } else if (value.length > 0 && !value.startsWith('+')) {
        value = '+90' + value;
    }
    
    this.value = value;
});
{{/contact_requirements.phone_or_email}}

{{#contact_requirements.phone_required}}
const requiredPhoneField = document.getElementById('customer_phone');
requiredPhoneField.addEventListener('input', function() {
    let value = this.value.replace(/\D/g, ''); // Remove non-digits
    
    // Turkish phone number formatting
    if (value.startsWith('90')) {
        value = '+' + value;
    } else if (value.startsWith('0')) {
        value = '+90' + value.substring(1);
    } else if (value.length > 0 && !value.startsWith('+')) {
        value = '+90' + value;
    }
    
    this.value = value;
});
{{/contact_requirements.phone_required}}

// Add smooth animations
document.addEventListener('DOMContentLoaded', function() {
    // Animate elements on page load
    const container = document.querySelector('.payment-container');
    container.style.opacity = '0';
    container.style.transform = 'translateY(50px)';
    
    setTimeout(() => {
        container.style.transition = 'all 0.6s ease';
        container.style.opacity = '1';
        container.style.transform = 'translateY(0)';
    }, 100);
    
    // Animate form elements
    const formElements = document.querySelectorAll('.form-group, .payment-method, .submit-button');
    formElements.forEach((element, index) => {
        element.style.opacity = '0';
        element.style.transform = 'translateY(20px)';
        
        setTimeout(() => {
            element.style.transition = 'all 0.4s ease';
            element.style.opacity = '1';
            element.style.transform = 'translateY(0)';
        }, 200 + (index * 50));
    });
});
</script> 