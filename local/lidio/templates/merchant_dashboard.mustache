{{!
    @template local_lidio/merchant_dashboard

    Merchant dashboard template.

    Classes required for JS:
    * none

    Context variables required for this template:
    * merchant - Merchant data object
    * strings - Array of language strings
    * transactions_url - URL to transactions page
    * is_admin - Boolean indicating if the user is an admin
    * admin_url - URL to merchant management page
}}

<div class="bg-gray-50 min-h-screen">
    <!-- Top Header Card -->
    <div class="bg-[#005eff] text-white p-6 rounded-lg shadow-lg m-4 md:m-6">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between">
            <div>
                <h2 class="text-2xl font-bold flex items-center">
                    <span>{{strings.welcome}}, {{merchant.company_name}}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </h2>
                <div class="mt-2">
                    <div class="text-sm opacity-80">{{strings.earnings}}</div>
                    <div class="text-3xl font-bold">₺{{stats.total_earnings}}</div>
                </div>
            </div>
            <div class="mt-4 md:mt-0">
                <a href="#" class="inline-flex items-center px-4 py-2 bg-white text-[#005eff] rounded-full font-medium hover:bg-blue-50 transition-colors">
                    {{strings.withdraw}}
                </a>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 px-4 md:px-6 mb-6">
        <!-- Total Revenue -->
        <div class="bg-white rounded-lg p-5 shadow">
            <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-full bg-[#e3f5c5] flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <span class="text-green-500 text-sm font-medium">
                    {{#stats.monthly_growth_positive}}↑ {{stats.monthly_growth}}%{{/stats.monthly_growth_positive}}
                    {{^stats.monthly_growth_positive}}↓ {{stats.monthly_growth}}%{{/stats.monthly_growth_positive}}
                </span>
            </div>
            <h3 class="text-gray-500 text-sm mb-1">{{strings.totalrevenue}}</h3>
            <div class="text-2xl font-bold text-gray-800">₺{{stats.total_earnings}}</div>
        </div>

        <!-- Current Balance -->
        <div class="bg-white rounded-lg p-5 shadow">
            <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-full bg-[#d1e7ff] flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                    </svg>
                </div>
                <a href="#" class="text-blue-500 text-sm font-medium">{{strings.withdraw}}</a>
            </div>
            <h3 class="text-gray-500 text-sm mb-1">{{strings.currentbalance}}</h3>
            <div class="text-2xl font-bold text-gray-800">₺{{merchant.balance}}</div>
        </div>

        <!-- Total Products -->
        <div class="bg-white rounded-lg p-5 shadow">
            <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-full bg-[#e3f5c5] flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                </div>
                <span class="text-green-500 text-sm font-medium"></span>
            </div>
            <h3 class="text-gray-500 text-sm mb-1">{{strings.totalproducts}}</h3>
            <div class="text-2xl font-bold text-gray-800"></div>
        </div>

        <!-- Total Sales -->
        <div class="bg-white rounded-lg p-5 shadow">
            <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-full bg-[#e3f5c5] flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                </div>
                <span class="text-red-500 text-sm font-medium"></span>
            </div>
            <h3 class="text-gray-500 text-sm mb-1">{{strings.totalsales}}</h3>
            <div class="text-2xl font-bold text-gray-800">{{stats.total_transactions}}</div>
        </div>
    </div>

    <!-- Add a new section for recent transactions -->
    <div class="bg-white rounded-lg p-5 shadow mb-6 mx-4 md:mx-6">
        <div class="flex justify-between items-center mb-4">
            <h3 class="font-semibold text-gray-800">{{strings.recenttransactions}}</h3>
            <a href="{{transactions_url}}" class="text-sm text-blue-500">{{strings.viewalltransactions}}</a>
        </div>
        
        {{#has_transactions}}
        <div class="overflow-x-auto">
            <table class="min-w-full bg-white">
                <thead>
                    <tr class="w-full h-12 border-b border-gray-200">
                        <th class="text-left pl-4 text-sm font-medium text-gray-500">#ID</th>
                        <th class="text-left pl-4 text-sm font-medium text-gray-500">{{strings.customername}}</th>
                        <th class="text-left pl-4 text-sm font-medium text-gray-500">{{strings.amount}}</th>
                        <th class="text-left pl-4 text-sm font-medium text-gray-500">{{strings.date}}</th>
                        <th class="text-left pl-4 text-sm font-medium text-gray-500">{{strings.status}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#recent_transactions}}
                    <tr class="h-12 border-b border-gray-200 hover:bg-gray-50">
                        <td class="text-left pl-4 text-sm font-medium text-gray-800">{{id}}</td>
                        <td class="text-left pl-4 text-sm text-gray-600">{{customer_name}}</td>
                        <td class="text-left pl-4 text-sm text-gray-600">₺{{amount}}</td>
                        <td class="text-left pl-4 text-sm text-gray-600">{{date}}</td>
                        <td class="text-left pl-4 text-sm">
                            <span class="{{status_class}} font-medium">{{status}}</span>
                        </td>
                    </tr>
                    {{/recent_transactions}}
                </tbody>
            </table>
        </div>
        {{/has_transactions}}
        
        {{^has_transactions}}
        <div class="bg-gray-50 p-6 rounded-lg text-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <p class="text-gray-600">{{strings.notransactions}}</p>
            <a href="{{create_payment_link_url}}" class="mt-4 inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                Create a payment link
            </a>
        </div>
        {{/has_transactions}}
    </div>
</div> 